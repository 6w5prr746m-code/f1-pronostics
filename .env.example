NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never prefix with NEXT_PUBLIC_. From Supabase Settings ->
# API -> service_role / secret key. Used by /admin/results to write race
# results and compute scores, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of emails allowed to access /admin/results.
ADMIN_EMAILS=you@example.com
